FROM node:20-alpine

# Install Docker CLI so the Vite backend plugin can fetch container logs
RUN apk add --no-cache docker-cli

WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm install

# Copy the rest of the application code
COPY . .

# Expose the default Vite port
EXPOSE 5173

# Start the Vite development server bound to 0.0.0.0 so it is accessible from the host
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
