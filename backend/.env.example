APP_NAME=Settle Backend
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

APP_VERSION=0.1.0

LOG_LEVEL=INFO
LOG_JSON=false

NODE_ID=node-1
NODE_NAME=payment-node-1
NODE_HOST=payment-node-1
NODE_PORT=8000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=settle
POSTGRES_USER=settle_user
POSTGRES_PASSWORD=change_me

# Optional override. Leave blank to build the connection string from POSTGRES_* above.
DATABASE_URL=

ZOOKEEPER_HOSTS=zookeeper:2181
ZOOKEEPER_NAMESPACE=/settle
ZOOKEEPER_SESSION_TIMEOUT=10.0
ZOOKEEPER_CONNECTION_TIMEOUT=10.0

HEALTH_CHECK_INTERVAL_SECONDS=5
REQUEST_TIMEOUT_SECONDS=5

# Stripe Configuration (Test Mode Only)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYMENT_CURRENCY=usd
PAYMENT_PROVIDER=stripe

# Email Service (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@settle.com
BREVO_SENDER_NAME=Settle
